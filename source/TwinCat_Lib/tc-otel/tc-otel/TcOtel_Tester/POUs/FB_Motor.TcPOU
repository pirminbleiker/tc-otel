<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.17">
  <POU Name="FB_Motor" Id="{fb6d8bde-3d9a-4b16-a0b1-2bfd3b2b8f5e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
:Description: Test FB to exercise ScopeResolver FB-type resolution.

Contains an embedded FB_Log instance. When instantiated inside a PRG
(e.g. ``fbMotor : FB_Motor;`` in ``PRG_TestSimpleApi``), the FB_Log's
auto-derived sLogger becomes ``PRG_TestSimpleApi.fbMotor.fbLog``.
The tc-otel ScopeResolver then strips the last segment, looks up
``PRG_TestSimpleApi.fbMotor`` in the PLC symbol table, finds type
``FB_Motor`` and uses that as ``InstrumentationScope.name``.

This is the smallest possible vehicle for proving end-to-end FB-type
resolution against a live runtime.
*)
FUNCTION_BLOCK FB_Motor
VAR
    fbLog        : FB_Log;
    nCycles      : DINT;
    nMotorId     : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{8b54ff24-e356-4ba3-a876-58818af0ac8c}">
      <Declaration><![CDATA[// Emits one INFO log per call via the embedded FB_Log.
// Logger name auto-resolved from instance path → ScopeResolver
// turns it into the FB type name (``FB_Motor``).
METHOD Cycle : BOOL
VAR_INPUT
    nId : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nMotorId := nId;
nCycles := nCycles + 1;

fbLog.Info('Motor {0} cycle {1}')
    .WithAnyArg(nMotorId)
    .WithAnyArg(nCycles)
    .CreateLog();

IF nCycles MOD 5 = 0 THEN
    fbLog.Warn('Motor {0} hit cycle {1} (every 5th)')
        .WithAnyArg(nMotorId)
        .WithAnyArg(nCycles)
        .CreateLog();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
